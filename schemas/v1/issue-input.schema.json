{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KYNaruto/agent-maintainer-kit/blob/main/schemas/v1/issue-input.schema.json",
  "title": "Agent Maintainer Kit Issue Input",
  "description": "Input accepted by the amk triage command.",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "additionalProperties": true
}

